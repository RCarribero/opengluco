# ==============================================================================
# OpenGluco Ecosystem - Contexto de Desarrollo Completo
# ==============================================================================
# Este archivo documenta toda la configuracion, arquitectura, herramientas,
# decisiones de diseno y contexto del proyecto para poder continuar el
# desarrollo en cualquier maquina con todo el conocimiento necesario.
#
# IMPORTANTE: Este archivo NO contiene credenciales ni secretos.
# Es un documento de referencia tecnica del proyecto.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. INFORMACION GENERAL DEL PROYECTO
# ------------------------------------------------------------------------------
PROJECT_NAME=OpenGluco Ecosystem
PROJECT_DESCRIPTION=Suite multiplataforma local-first para monitorizacion secundaria pasiva de glucosa continua (CGM) desde OpenGluco / Abbott Cloud
PROJECT_TYPE=Android Multi-Module (Kotlin + Jetpack Compose)
PACKAGE_NAME=com.example.opengluco
MIN_SDK=30
TARGET_SDK=35
COMPILE_SDK=35

# ------------------------------------------------------------------------------
# 2. MODULOS Y ARQUITECTURA
# ------------------------------------------------------------------------------
# Estructura de modulos Gradle:
#
# :core:model      -> Modelos de dominio clinico (GlucoseMeasurement, GlucoseColorRange, TrendArrow, GlucoseUnit)
# :core:network    -> Cliente REST directo contra la API oficial de OpenGluco (TLS, sin servidores intermedios)
# :core:data       -> Persistencia local-first: Android Keystore AES-256-GCM, DataStore, historial 90 dias, exportacion CSV (RGPD Art.20), purga total (RGPD Art.17)
# :app-mobile      -> Cliente Android movil completo con dashboard, graficas, alarmas, informes clinicos, ajustes, QR scanner
# :app-wear        -> Cliente Wear OS (Galaxy Watch) con esferas flotantes duales, sparkline Bezier, tiles, complicaciones
# :app-auto        -> Cliente Android Auto con PaneTemplate glanceable, disclaimer pasivo, sin distraccion al volante
#
MODULES=:core:model,:core:network,:core:data,:app-mobile,:app-wear,:app-auto

# ------------------------------------------------------------------------------
# 3. TOOLCHAIN Y VERSIONES
# ------------------------------------------------------------------------------
KOTLIN_VERSION=2.0.0
AGP_VERSION=8.5.2
COMPOSE_COMPILER_VERSION=2.0.0
GRADLE_WRAPPER_VERSION=8.7
JAVA_VERSION=17
KOTLINX_SERIALIZATION_VERSION=2.0.0

# Dependencias clave (definidas en cada build.gradle.kts de modulo):
# - Jetpack Compose BOM
# - Compose Material 3
# - Compose Material Icons Extended
# - Wear Compose Material / Foundation / Navigation
# - AndroidX Car App Library (Android Auto)
# - CameraX + ZXing (QR Scanner)
# - OkHttp + Retrofit (HTTP client)
# - Kotlinx Serialization JSON
# - AndroidX DataStore Preferences
# - AndroidX Security Crypto (Keystore)

# ------------------------------------------------------------------------------
# 4. SISTEMA DE DISENO CLINICO
# ------------------------------------------------------------------------------
# Filosofia: Minimalismo Clinico con Glassmorphism Sutil
# Objetivo: Maxima legibilidad medica de un vistazo (glanceability)
#
# Paleta de colores (tokens centralizados en ClinicalTheme):
COLOR_BACKGROUND=#000000
COLOR_SURFACE_ORB=#1E232D
COLOR_SURFACE_CARD=#161A22
COLOR_SURFACE_BORDER=#2D3748
COLOR_MINT_IN_RANGE=#4ADE80
COLOR_LOW_CORAL=#F87171
COLOR_URGENT_CRIMSON=#EF4444
COLOR_HIGH_AMBER=#FBBF24
COLOR_VERY_HIGH_ORANGE=#FB923C
COLOR_ARCTIC_CYAN=#38BDF8
COLOR_LOW_YELLOW=#FBBF24
COLOR_TEXT_PRIMARY=#FFFFFF
COLOR_TEXT_SECONDARY=#94A3B8
COLOR_TEXT_MUTED=#64748B

# Rangos clinicos de glucosa (mg/dL):
RANGE_URGENT_LOW_MAX=55
RANGE_LOW_MIN=56
RANGE_LOW_MAX=69
RANGE_IN_RANGE_MIN=70
RANGE_IN_RANGE_MAX=180
RANGE_HIGH_MIN=181
RANGE_HIGH_MAX=249
RANGE_VERY_HIGH_MIN=250

# Formato de hora: siempre 24h (HH:mm)
# Simbolos de tendencia: caracteres vectoriales limpios (flecha, flecha arriba, etc.)
# REGLA ESTRICTA: CERO emojis en todo el repositorio (codigo, UI, comentarios, documentacion)

# ------------------------------------------------------------------------------
# 5. FUNCIONALIDADES DE LA APP MOVIL (app-mobile)
# ------------------------------------------------------------------------------
# Dashboard Principal:
#   - Valor de glucosa actual con color clinico y tendencia
#   - Grafica de curva continua Bezier con scrubbing interactivo (haptic feedback)
#   - Selector de intervalo temporal ciclico: 24h -> 12h -> 6h -> 2h -> 1h (boton en la cabecera de la grafica)
#   - El eje X de la grafica usa coordenadas de tiempo real (proporcional al timestamp), no por indice
#   - Marcadores temporales inferiores (-24h, -12h, Ahora; etc.)
#   - Badge de dias restantes de sensor
#   - Estadisticas resumidas (promedio, minimo, maximo, GMI, tiempo en rango)
#
# Sistema de Alarmas:
#   - Alarmas configurables por umbral (mg/dL), tipo (HIGH/LOW), severidad (URGENT/ALERT/INFORMATIVE)
#   - Colores: Amarillo para alertas bajas (no rosa), Rojo para urgentes, Naranja para muy altas
#   - Rango objetivo personalizable con dialog modal (presets: Estandar 70-180, Estricto 70-140, Gestacional 63-140)
#   - Persistencia en AlarmRepository con DataStore
#
# Informes Clinicos:
#   - Daily Patterns (percentiles 10/25/50/75/90 por hora, navegacion por fecha)
#   - Time In Range (5 rangos de consenso ATTD 2019)
#   - Low Glucose Events (deteccion >= 15 min, 4 franjas horarias)
#   - Average Glucose (general + por franjas)
#   - Daily Graph (agrupacion por fecha con metricas)
#   - Estimated A1c / GMI (formula Bergenstal: GMI% = 3.31 + 0.02392 * media_mgdl)
#
# Configuracion (Drawer lateral):
#   - Tema: OLED Oscuro / Claro (boton de estado, no toggle)
#   - Unidades: mg/dL / mmol/L (boton de estado, no toggle)
#   - Gestion de Alarmas
#   - Rango Objetivo personalizable
#   - Vinculacion QR (CameraX + ZXing)
#   - Exportacion CSV (RGPD Art.20)
#   - Borrado total de datos (RGPD Art.17)
#   - Avisos legales (Descargo Medico MDR/FDA, Marcas/No Afiliacion, Privacidad RGPD)
#
# Autenticacion:
#   - Login con email/password contra API oficial OpenGluco
#   - Transfer QR cifrado entre dispositivos

# ------------------------------------------------------------------------------
# 6. FUNCIONALIDADES DE LA APP WEAR OS (app-wear)
# ------------------------------------------------------------------------------
# - Esferas flotantes duales (74dp): Glucosa + Tendencia
# - Sparkline Bezier continua con sombreado clinico
# - Badge de dias de sensor
# - Feedback haptico en interacciones tactiles
# - Tiles (GlucoseTileService) y Complicaciones (GlucoseComplicationService)
# - Sincronizacion Bluetooth DataLayer
# - Ajustes: Disclaimers legales, borrado local
# - Footer legal pasivo permanente
# - Soporte rotary touch para navegacion

# ------------------------------------------------------------------------------
# 7. FUNCIONALIDADES DE LA APP ANDROID AUTO (app-auto)
# ------------------------------------------------------------------------------
# - PaneTemplate con dashboard glanceable (valor glucosa, tendencia, ultima lectura)
# - Fila de disclaimer pasivo (sin distraccion al volante)
# - Network security config restrictiva
# - Sin interaccion compleja (cumplimiento normativa conduccion)

# ------------------------------------------------------------------------------
# 8. SEGURIDAD Y CUMPLIMIENTO NORMATIVO
# ------------------------------------------------------------------------------
# Cifrado:
#   - Android Keystore AES-256-GCM para JWT tokens e historial
#   - Alias: opengluco_master_keystore_key_v1
#   - Formato: "ENC:" + Base64(IV + Ciphertext + Tag)
#
# RGPD:
#   - Art.9: Tratamiento de datos de salud local-first (sin cloud intermediario)
#   - Art.17: Borrado total e irreversible (purgeAllLocalData)
#   - Art.20: Exportacion CSV estructurada (HealthDataExporter)
#
# Regulacion Medica:
#   - MDR UE 2017/745 / FDA MDDS: Uso informativo secundario
#   - Prohibicion de dosificacion de insulina / calculo de bolos
#   - Disclaimer pasivo permanente en todas las vistas
#   - Aviso de marcas y no afiliacion con Abbott Laboratories
#
# Manifiestos:
#   - android:allowBackup="false" en los tres modulos de app
#   - Network security config restrictiva

# ------------------------------------------------------------------------------
# 9. PERSISTENCIA DE DATOS
# ------------------------------------------------------------------------------
# - UserPreferencesRepository: DataStore + archivos JSON cifrados
# - Historial acumulativo de 90 dias con deduplicacion por timestamp (epochMs)
# - La API de OpenGluco solo entrega ~8-12 horas por peticion
# - combinedHistory fusiona: periodReadings (cache local) + history (API en vivo) + currentMeasurement
# - chartHistory filtra por el timeframe seleccionado usando tMax - (horas * 3600 * 1000ms)

# ------------------------------------------------------------------------------
# 10. COMO COMPILAR Y EJECUTAR
# ------------------------------------------------------------------------------
# Requisitos:
#   - JDK 17+
#   - Android SDK con API 35
#   - Android Studio Ladybug o superior (recomendado)
#   - Dispositivo fisico o emulador con API >= 30
#
# Compilar todo:
#   ./gradlew assembleDebug
#
# Tests unitarios:
#   ./gradlew testDebugUnitTest
#
# Instalar en movil conectado:
#   adb install -r app-mobile/build/outputs/apk/debug/app-mobile-debug.apk
#
# Instalar en reloj conectado:
#   adb install -r app-wear/build/outputs/apk/debug/app-wear-debug.apk
#
# Verificar 0 emojis (regla del proyecto):
#   python scripts/verify_no_emojis.py (o ejecutar el script de verificacion)

# ------------------------------------------------------------------------------
# 11. CONVENCIONES DE CODIGO
# ------------------------------------------------------------------------------
# - Kotlin code style: official
# - CERO emojis en todo el repositorio (codigo, UI, comentarios, strings, documentacion)
# - Comentarios en espanol (sin tildes en codigo fuente para evitar encoding issues)
# - Formato 24h siempre (HH:mm)
# - Nombres de variables/funciones en ingles, comentarios en espanol
# - Jetpack Compose para toda la UI
# - Sin dependencias de terceros para almacenamiento (solo DataStore + Keystore nativo)

